{
    "PARAMETERS_SETS": {
        "sklearn": {
            "implementation": {
                "library": "sklearn"
            }
        },
        "sklearnex[cpu]": {
            "implementation": {
                "library": "sklearnex",
                "device": "cpu",
                "sklearnex_context": {
                    "allow_fallback_to_host": false,
                    "allow_sklearn_after_onedal": false
                }
            }
        },
        "sklearnex[gpu]": [
            {
                "implementation": {
                    "library": "sklearnex",
                    "device": "gpu",
                    "data_library": "dpnp",
                    "sklearnex_context": {
                        "array_api_dispatch": true,
                        "allow_fallback_to_host": false,
                        "allow_sklearn_after_onedal": false
                    }
                }
            }
        ],
        "sklearn[torch-xpu,dpnp-gpu]": [
            {
                "implementation": {
                    "library": "sklearn",
                    "device": "xpu",
                    "data_library": "torch",
                    "sklearn_context": {
                        "array_api_dispatch": true
                    }
                }
            },
            {
                "implementation": {
                    "library": "sklearn",
                    "device": "gpu",
                    "data_library": "dpnp",
                    "sklearn_context": {
                        "array_api_dispatch": true
                    }
                }
            }
        ],
        "sklearn[torch-cpu]": {
            "implementation": {
                "library": "sklearn",
                "device": "cpu",
                "data_library": "torch",
                "sklearn_context": {
                    "array_api_dispatch": true
                }
            }
        },
        "sklearn[torch-cuda,cupy-cuda]": [
            {
                "implementation": {
                    "library": "sklearn",
                    "device": "cuda",
                    "data_library": "torch",
                    "sklearn_context": {
                        "array_api_dispatch": true
                    }
                }
            },
            {
                "implementation": {
                    "library": "sklearn",
                    "device": "cuda",
                    "data_library": "cupy",
                    "sklearn_context": {
                        "array_api_dispatch": true
                    }
                }
            }
        ]
    }
}
