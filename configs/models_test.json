{
    "PARAMETERS_SETS": {
        "trees": {
            "bench": {
                "n_runs": 3
            },
            "algorithm": {
                "estimator_params": {
                    "random_state": 42,
                    "n_estimators": 16,
                    "max_features": 0.5,
                    "max_depth": 4,
                    "n_jobs": 1
                },
                "estimator_methods": { "inference": "predict" }
            },
            "data": {
                "generation_kwargs": {
                    "n_informative": "[SPECIAL_VALUE]0.5",
                    "n_samples": 1000,
                    "n_features": 10
                },
                "split_kwargs": { "test_size": 0.2 }
            }
        },
        "trees+": [
            {
                "algorithm": {
                    "estimator": ["RandomForestClassifier", "ExtraTreesClassifier"]
                },
                "data": {
                    "source": "make_trees_classification_data",
                    "generation_kwargs": {
                        "columns": "mix",
                        "n_classes": 2
                    }
                }
            },
            {
                "algorithm": {
                    "estimator": ["RandomForestRegressor", "ExtraTreesRegressor"]
                },
                "data": {
                    "source": "make_trees_regression_data",
                    "generation_kwargs": {
                        "columns": "mix",
                        "noise": 0.1
                    }
                }
            }
        ],
        "linear": {
            "bench": {
                "n_runs": 3
            },
            "algorithm": {
                "estimator_methods": { "inference": "predict" }
            },
            "data": {
                "generation_kwargs": {
                    "n_informative": "[SPECIAL_VALUE]0.5"
                },
                "generation_kwargs+": [
                    {"n_samples": 3000, "n_features": 20}
                ],
                "split_kwargs": { "test_size": 0.2 }
            }
        },
        "linear+": [
            {
                "algorithm": {
                    "estimator": ["Ridge", "LinearRegression"]
                },
                "data": {
                    "source": "make_regression",
                    "order": "C"
                }
            },
            {
                "algorithm": {
                    "estimator": "LogisticRegression",
                    "estimator_params": {
                        "solver": ["lbfgs", "newton-cg"]
                    }
                },
                "data": {
                    "source": "make_classification",
                    "generation_kwargs": {
                        "n_classes": 2
                    },
                    "order": "C"
                }
            }
        ],
        "linear array-API": {
            "bench": {
                "n_runs": 3
            },
            "algorithm": {
                "estimator_methods": { "inference": "predict" }
            },
            "data": {
                "generation_kwargs": {
                    "n_informative": "[SPECIAL_VALUE]0.5"
                },
                "generation_kwargs+": [
                    {"n_samples": 1000, "n_features": 20}
                ],
                "split_kwargs": { "test_size": 0.2 }
            }
        },
        "linear array-API+": [
            {
                "algorithm": {
                    "estimator": "Ridge",
                    "estimator_params": {
                        "solver": "svd"
                    }
                },
                "data": {
                    "source": "make_regression",
                    "order": "C"
                }
            },
            {
                "algorithm": [
                    {"estimator": "LogisticRegression"},
                    {
                        "estimator": "RidgeClassifier",
                        "estimator_params": {
                            "solver": "svd"
                        }
                    }
                ],
                "data": {
                    "source": "make_classification",
                    "generation_kwargs": {
                        "n_classes": 2
                    }
                }
            }
        ],
        "clustering": {
            "bench": {
                "n_runs": 3
            },
            "algorithm": {
                "estimator_methods": { "inference": "predict" }
            }
        },
        "clustering+": [
            {
                "algorithm": {
                    "estimator": "KMeans",
                    "estimator_params": {
                        "n_clusters": "[SPECIAL_VALUE]auto",
                        "n_init": 1,
                        "max_iter": 30,
                        "tol": 0.001,
                        "random_state": 42
                    }
                },
                "data": {
                    "source": "make_blobs",
                    "generation_kwargs": {
                        "centers": 5,
                        "cluster_std": 1.0,
                        "n_samples": 2000,
                        "n_features": 20
                    },
                    "split_kwargs": { "ignore": true }
                }
            },
            {
                "algorithm": {
                    "estimator": "DBSCAN",
                    "estimator_params": {
                        "eps": "[SPECIAL_VALUE]distances_quantile:0.01",
                        "min_samples": 5,
                        "metric": "euclidean"
                    }
                },
                "data": {
                    "source": "make_blobs",
                    "generation_kwargs": {
                        "centers": 5,
                        "cluster_std": 2.0,
                        "n_samples": 1000,
                        "n_features": 20
                    },
                    "split_kwargs": { "ignore": true }
                }
            }
        ]
    }
}
